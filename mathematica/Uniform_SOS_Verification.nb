Cell["\<\
Hence, for every \[Theta] \[Element] (\[Pi]/8, \[Pi]/4],  Id - \[Beta] = \
\[Sum]_ab (W_ab/\[Mu]) aj[N_a] ** N_b  with W/\[Mu] positive definite: an SOS \
certificate of \[Beta] \[LessEqual] 1, valid in every dimension. The smallest \
eigenvalue tends to zero as v \[Rule] 0 (\[Theta] \[Rule] \[Pi]/8), where \
further deterministic behaviours become optimal.\
\>", "Text",ExpressionUUID->"8043be36-bdd8-44e4-9950-d608be92778e"],

Cell["All six families", "Section",ExpressionUUID->"ff365165-fa19-401f-a327-f4951ef157ba"],

Cell["\<\
The same checks for every family. V2 lives on 0 < v \[LessEqual] vbar and V5, \
V6 on vbar \[LessEqual] v \[LessEqual] 1; positivity of W is checked on the \
open part. At vbar, W is the limit of positive definite matrices, so W(vbar) \
is positive semidefinite, and \[Mu](vbar) > 0 is checked separately. Each row \
also checks that the Bell expression of Orthogonal.nb at the vertex is the \
\[Beta] of the certificate, and that W is symmetric. The mirror vertices \
follow from the symmetry A0 \[LeftRightArrow] A1, B1 \[Rule] -B1.\
\>", "Text",ExpressionUUID->"728e755f-3ca2-4c7f-ab38-c9c74dcf5657"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"check", "[", "name_", "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"cc", " ", "=", " ", 
        RowBox[{"certs", "[", "name", "]"}]}], ",", " ", "nn", ",", " ", "w", 
       ",", " ", "m", ",", " ", "b", ",", " ", "lo", ",", " ", "hi", ",", " ",
        "cond", ",", " ", "bell", ",", " ", "null", ",", " ", "det", ",", " ",
        "id", ",", " ", "sym", ",", " ", "pos", ",", " ", "ends"}], "}"}], 
     ",", "\n", "   ", 
     RowBox[{
      RowBox[{"nn", " ", "=", " ", 
       RowBox[{"cc", "[", "\"\<nullifiers\>\"", "]"}]}], ";", " ", 
      RowBox[{"w", " ", "=", " ", 
       RowBox[{"cc", "[", "\"\<W\>\"", "]"}]}], ";", " ", 
      RowBox[{"m", " ", "=", " ", 
       RowBox[{"cc", "[", "\"\<mu\>\"", "]"}]}], ";", " ", 
      RowBox[{"b", " ", "=", " ", 
       RowBox[{"cc", "[", "\"\<beta\>\"", "]"}]}], ";", " ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"lo", ",", " ", "hi"}], "}"}], " ", "=", " ", 
       RowBox[{"cc", "[", "\"\<range\>\"", "]"}]}], ";", "\n", "   ", 
      RowBox[{"cond", " ", "=", " ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"hi", " ", "===", " ", "1"}], ",", " ", 
         RowBox[{"lo", " ", "<", " ", "v", " ", "<=", " ", "1"}], ",", " ", 
         RowBox[{"lo", " ", "<", " ", "v", " ", "<", " ", "hi"}]}], "]"}]}], 
      ";", "\n", "   ", 
      RowBox[{"bell", " ", "=", " ", 
       RowBox[{"AllTrue", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"betaV", " ", "/.", " ", 
            RowBox[{"vertex", "[", "name", "]"}]}], ")"}], " ", "-", " ", 
          RowBox[{"coeffs", "[", "b", "]"}]}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"Simplify", "[", "#", "]"}], " ", "===", " ", "0"}], " ", 
          "&"}]}], "]"}]}], ";", "\n", "   ", 
      RowBox[{"null", " ", "=", " ", 
       RowBox[{"AllTrue", "[", 
        RowBox[{"nn", ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"Simplify", "[", 
            RowBox[{
             RowBox[{"toMatrix", "[", "#", "]"}], " ", ".", " ", 
             RowBox[{"psi", "[", "v", "]"}]}], "]"}], " ", "===", " ", 
           RowBox[{"{", 
            RowBox[{"0", ",", " ", "0", ",", " ", "0", ",", " ", "0"}], 
            "}"}]}], " ", "&"}]}], "]"}]}], ";", "\n", "   ", 
      RowBox[{"det", " ", "=", " ", 
       RowBox[{"AllTrue", "[", 
        RowBox[{
         RowBox[{"Flatten", "[", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"Simplify", "[", 
             RowBox[{"atDeterministic", "[", 
              RowBox[{"x", ",", " ", "d"}], "]"}], "]"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"x", ",", " ", "nn"}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"d", ",", " ", 
              RowBox[{"cc", "[", "\"\<deterministic\>\"", "]"}]}], "}"}]}], 
           "]"}], "]"}], ",", " ", 
         RowBox[{
          RowBox[{"#", " ", "===", " ", "0"}], " ", "&"}]}], "]"}]}], ";", 
      "\n", "   ", 
      RowBox[{"id", " ", "=", " ", 
       RowBox[{"zeroQ", "[", 
        RowBox[{
         RowBox[{"NCQuadraticForm", "[", 
          RowBox[{"nn", ",", " ", "w", ",", " ", "nn"}], "]"}], " ", "-", " ", 
         RowBox[{"NCExpandReplaceRepeated", "[", 
          RowBox[{
           RowBox[{"m", " ", 
            RowBox[{"(", 
             RowBox[{"Id", " ", "-", " ", "b"}], ")"}]}], ",", " ", 
           "myRules"}], "]"}]}], "]"}]}], ";", "\n", "   ", 
      RowBox[{"sym", " ", "=", " ", 
       RowBox[{
        RowBox[{"Simplify", "[", 
         RowBox[{"w", " ", "-", " ", 
          RowBox[{"Transpose", "[", "w", "]"}]}], "]"}], " ", "===", " ", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{"0", ",", " ", 
          RowBox[{"Dimensions", "[", "w", "]"}]}], "]"}]}]}], ";", "\n", 
      "   ", 
      RowBox[{"pos", " ", "=", " ", 
       RowBox[{"Resolve", "[", 
        RowBox[{
         RowBox[{"ForAll", "[", 
          RowBox[{"v", ",", " ", "cond", ",", " ", 
           RowBox[{
            RowBox[{"And", " ", "@@", " ", 
             RowBox[{"Thread", "[", 
              RowBox[{
               RowBox[{"leadingMinors", "[", "w", "]"}], " ", ">", " ", "0"}],
               "]"}]}], " ", "&&", " ", 
            RowBox[{"m", " ", ">", " ", "0"}]}]}], "]"}], ",", " ", "Reals"}],
         "]"}]}], ";", "\n", "   ", 
