Cell["The identity", "Subsection",ExpressionUUID->"3fb408db-84a7-4bdb-8d2a-5da09f4b3e51"],

Cell["\[Mu](v)(Id - \[Beta]) - \[Sum]_ab W_ab aj[N_a] ** N_b reduces to \
zero:", "Text",ExpressionUUID->"414bfb53-ae9c-4e1e-9ce9-124eb402c99b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"lhs", " ", "=", " ", 
   RowBox[{"NCQuadraticForm", "[", 
    RowBox[{"NN", ",", " ", "W", ",", " ", "NN"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"rhs", " ", "=", " ", 
   RowBox[{"NCExpandReplaceRepeated", "[", 
    RowBox[{
     RowBox[{"mu", " ", 
      RowBox[{"(", 
       RowBox[{"Id", " ", "-", " ", "beta"}], ")"}]}], ",", " ", "myRules"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"zeroQ", "[", 
  RowBox[{"lhs", " ", "-", " ", "rhs"}], "]"}]}], "Input",
 CellLabel->"In[25]:=",ExpressionUUID->"887c78fc-c2f2-4986-92ae-cd15c1d28d40"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[25]=",ExpressionUUID->"df9f0e8d-c53d-4350-be72-7dfe4242d74b"],

Cell["Positivity", "Subsection",ExpressionUUID->"64648e95-3eb0-4824-9af9-acb05e2e3a76"],

Cell["\<\
All leading principal minors of W(v) are positive for 0 < v \[LessEqual] 1, \
and \[Mu](v) > 0:\
\>", "Text",ExpressionUUID->"2490f416-3dd0-4cbf-b032-cce403722a13"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"minors", " ", "=", " ", 
   RowBox[{"leadingMinors", "[", "W", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Exponent", "[", 
    RowBox[{"#", ",", " ", "v"}], "]"}], " ", "&"}], " ", "/@", " ", 
  "minors"}]}], "Input",
 CellLabel->"In[26]:=",ExpressionUUID->"e2a13456-217d-4488-abc8-29ed9a403eee"],

