 RowBox[{"Resolve", "[", 
  RowBox[{
   RowBox[{"ForAll", "[", 
    RowBox[{"v", ",", " ", 
     RowBox[{"0", " ", "<", " ", "v", " ", "<=", " ", "1"}], ",", " ", 
     RowBox[{
      RowBox[{"And", " ", "@@", " ", 
       RowBox[{"Thread", "[", 
        RowBox[{"minors", " ", ">", " ", "0"}], "]"}]}], " ", "&&", " ", 
      RowBox[{"mu", " ", ">", " ", "0"}]}]}], "]"}], ",", " ", "Reals"}], 
  "]"}]], "Input",
