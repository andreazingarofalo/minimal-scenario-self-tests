           RowBox[{"-", "cth"}], "/", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Sqrt", "[", "2", "]"}], " ", "kk"}], ")"}]}], ",", " ", 
          
          RowBox[{
           RowBox[{"-", "sth"}], " ", 
           RowBox[{"cth", "/", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Sqrt", "[", "2", "]"}], " ", "kk"}], ")"}]}]}]}], 
         "}"}]}], " ", "+", "\n", "   ", 
       RowBox[{"r1", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", 
          RowBox[{"sth", "/", 
           RowBox[{"Sqrt", "[", "2", "]"}]}], ",", " ", 
          RowBox[{
           RowBox[{"-", "sth"}], "/", 
           RowBox[{"Sqrt", "[", "2", "]"}]}], ",", " ", "0", ",", " ", 
          RowBox[{"-", "1"}], ",", " ", "0", ",", " ", 
          RowBox[{"cth", "/", 
           RowBox[{"Sqrt", "[", "2", "]"}]}], ",", " ", "0", ",", " ", 
          RowBox[{"cth", "/", 
           RowBox[{"Sqrt", "[", "2", "]"}]}]}], "}"}]}]}]}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"Simplify", "[", 
  RowBox[{"betaV", " ", "-", " ", "paperPlane"}], "]"}]}], "Input",
 CellLabel->"In[11]:=",ExpressionUUID->"9fa37ea8-78f8-46f5-ad80-26e60f66f607"],

