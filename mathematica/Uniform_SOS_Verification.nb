Cell["\<\
Each family is the intersection of the lines \[Beta]\[CenterDot]D = 1 of its \
two saturated deterministic behaviours D, stored in \
certs[name][\"deterministic\"] as (A0, A1, B0, B1). Solving these two linear \
equations gives the vertex (r0(v), r1(v)) exactly. The table shows it at the \
middle of each range:\
\>", "Text",ExpressionUUID->"6bc0c86b-30c1-481c-a552-49a63b1ae74b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"detVec", "[", 
    RowBox[{"{", 
     RowBox[{"x0_", ",", " ", "x1_", ",", " ", "y0_", ",", " ", "y1_"}], 
     "}"}], "]"}], " ", ":=", " ", 
   RowBox[{"{", 
    RowBox[{
    "0", ",", " ", "x0", ",", " ", "x1", ",", " ", "y0", ",", " ", "y1", ",", 
     " ", 
     RowBox[{"x0", " ", "y0"}], ",", " ", 
     RowBox[{"x0", " ", "y1"}], ",", " ", 
     RowBox[{"x1", " ", "y0"}], ",", " ", 
     RowBox[{"x1", " ", "y1"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"vertex", "[", "name_", "]"}], " ", ":=", " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{"First", "[", 
     RowBox[{"Solve", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"betaV", " ", ".", " ", 
           RowBox[{"detVec", "[", "d", "]"}]}], " ", "==", " ", "1"}], ",", 
         " ", 
         RowBox[{"{", 
          RowBox[{"d", ",", " ", 
           RowBox[{
            RowBox[{"certs", "[", "name", "]"}], "[", "\"\<deterministic\>\"",
             "]"}]}], "}"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"r0", ",", " ", "r1"}], "}"}]}], "]"}], "]"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"TableForm", "[", 
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"vm", " ", "=", " ", 
         RowBox[{"Mean", "[", 
          RowBox[{
           RowBox[{"certs", "[", "name", "]"}], "[", "\"\<range\>\"", "]"}], 
          "]"}]}], "}"}], ",", "\n", "   ", 
       RowBox[{"{", 
        RowBox[{"name", ",", " ", 
         RowBox[{
          RowBox[{"certs", "[", "name", "]"}], "[", "\"\<vertex\>\"", "]"}], 
         ",", " ", 
         RowBox[{"N", "[", 
          RowBox[{"vm", ",", " ", "6"}], "]"}], ",", " ", 
         RowBox[{"N", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{"r0", ",", " ", "r1"}], "}"}], " ", "/.", " ", 
             RowBox[{"vertex", "[", "name", "]"}]}], " ", "/.", " ", 
            RowBox[{"v", " ", "->", " ", "vm"}]}], ",", " ", "6"}], "]"}]}], 
        "}"}]}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"name", ",", " ", 
       RowBox[{"Keys", "[", "certs", "]"}]}], "}"}]}], "]"}], ",", "\n", " ", 
   
   RowBox[{"TableHeadings", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"None", ",", " ", 
      RowBox[{"{", 
       RowBox[{
       "\"\<family\>\"", ",", " ", "\"\<lines\>\"", ",", " ", "\"\<v\>\"", 
        ",", " ", "\"\<(r0, r1)\>\""}], "}"}]}], "}"}]}]}], "]"}]}], "Input",
 CellLabel->"In[12]:=",ExpressionUUID->"228e661f-e6eb-4e5a-b49a-654b3c35738d"],

