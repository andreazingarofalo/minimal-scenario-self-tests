Cell["\<\
At these points no deterministic behaviour gives more than 1. Here this is \
checked at three values of v inside each range. The proof for every v is \
polygon_proof.wl.\
\>", "Text",ExpressionUUID->"27f8c43a-6a73-48db-a565-ab8bec35eb8b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"allDet", " ", "=", " ", 
   RowBox[{"Tuples", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", "4"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"lo", ",", " ", "hi"}], "}"}], ",", "\n", "   ", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"lo", ",", " ", "hi"}], "}"}], " ", "=", " ", 
        RowBox[{
         RowBox[{"certs", "[", "name", "]"}], "[", "\"\<range\>\"", "]"}]}], 
       ";", "\n", "   ", 
       RowBox[{"{", 
        RowBox[{"name", ",", " ", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"N", "[", 
            RowBox[{
             RowBox[{"Max", "[", 
              RowBox[{"N", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{
                   RowBox[{
                    RowBox[{"(", 
                    RowBox[{"betaV", " ", "/.", " ", 
                    RowBox[{"vertex", "[", "name", "]"}]}], ")"}], " ", ".", 
                    " ", 
                    RowBox[{"detVec", "[", "#", "]"}]}], " ", "&"}], " ", "/@",
                   " ", "allDet"}], " ", "/.", " ", 
                 RowBox[{"v", " ", "->", " ", 
                  RowBox[{"lo", " ", "+", " ", 
                   RowBox[{"x", " ", 
                    RowBox[{"(", 
                    RowBox[{"hi", " ", "-", " ", "lo"}], ")"}]}]}]}]}], ",", 
                " ", "30"}], "]"}], "]"}], ",", " ", "10"}], "]"}], ",", " ", 
           
           RowBox[{"{", 
            RowBox[{"x", ",", " ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"1", "/", "4"}], ",", " ", 
               RowBox[{"1", "/", "2"}], ",", " ", 
               RowBox[{"3", "/", "4"}]}], "}"}]}], "}"}]}], "]"}]}], 
        "}"}]}]}], "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"Keys", "[", "certs", "]"}]}], "}"}]}], "]"}], " ", "//", " ", 
  "TableForm"}]}], "Input",
 CellLabel->"In[13]:=",ExpressionUUID->"51dad5c7-2efa-4972-827f-ab9e19e28d27"],

