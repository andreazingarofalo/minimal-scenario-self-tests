    TableHeadings -> {{"V1", "V5", "V6", "V3", "V4", "V3'", "V6'", "V5'"}, {
      "lines not parallel", "other constraints strict"}}]]]], "Output",
 CellChangeTimes->{4.002795002668757*^9},
 CellLabel->
  "Out[26]//TableForm=",ExpressionUUID->"9737b2a0-3288-4033-884d-\
1574f4e94686"]
}, Open  ]],

Cell["\<\
The interval above is open, so we check the end point \[Theta] = \[Pi]/4 (v = \
1) separately, with exact numbers:\
\>", "Text",ExpressionUUID->"6c4e4cd7-7739-4b8d-af68-cc806a0f0289"],

Cell[CellGroupData[{

Cell["\<\
atPiQuarter[pair_] := Module[{V = vertex @@ pair},
   RootReduce[V[[3]] /. v -> 1] != 0 &&
    AllTrue[Complement[allDet, pair], RootReduce[slack[#, V] /. v -> 1] > 0 \
&]];
piQuarterCheck = atPiQuarter /@ octagon\
\>", "Input",
 CellLabel->"In[27]:=",ExpressionUUID->"cce9bf92-501b-47df-9263-17a988ba9696"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"V1\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"V5\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"V6\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"V3\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"V4\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"V3'\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"V6'\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"V5'\"\>", "\[Rule]", "True"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellChangeTimes->{4.00279502281275*^9},
 CellLabel->"Out[28]=",ExpressionUUID->"3f921830-e569-4b46-81d7-5953e8e9a0a9"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["At \[Theta]bar", "Subsection",ExpressionUUID->"b97996c1-bd82-488c-8cce-b2372e8c91ee"],

Cell["\<\
At \[Theta]bar the vertex V2 = I(+,+) \[Intersection] II(-,+) also lies on \
the line of I(-,+), and its mirror image V2' on the line of I(-,-). All the \
other constraints stay strict. This is item (iii) of the proposition.\
\>", "Text",ExpressionUUID->"1cd8960c-bf97-438e-b6c3-af7f791b03f8"],

Cell[CellGroupData[{

Cell["\<\
atThetaBar[pair_] := Module[{V = vertex @@ pair, sl},
   sl = AssociationMap[RootReduce[slack[#, V] /. v -> vbar] &, \
Complement[allDet, pair]];
   {Keys[Select[sl, # == 0 &]], AllTrue[Values[Select[sl, # != 0 &]], # > 0 \
&]}];
barCheck = atThetaBar /@ hexagon;
TableForm[Values[barCheck], TableHeadings -> {Keys[hexagon], {\"extra active \
constraints\", \"others strict\"}}]\
\>", "Input",
 CellLabel->"In[29]:=",ExpressionUUID->"0655d0b8-4142-4aaf-9dbe-596fd9cffdb5"],

