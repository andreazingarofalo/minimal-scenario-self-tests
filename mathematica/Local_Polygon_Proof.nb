Cell[CellGroupData[{

Cell["The limit \[Theta] \[Rule] \[Pi]/8", "Subsection",ExpressionUUID->"4559ce02-1fba-4b28-a516-a271d9b61f1a"],

Cell["\<\
When v \[Rule] 0 the hexagon collapses onto the segment r0 = 1/\[Sqrt]2, |r1| \
\[LessEqual] \[Sqrt]2 - 1, item (v) of the proposition. Once simplified with \
Together, the coordinates of the vertices have denominators that do not \
vanish at v = 0, so the limit is the value at v = 0:\
\>", "Text",ExpressionUUID->"d044a666-16de-4901-8221-98d63399808f"],

Cell[CellGroupData[{

Cell["\<\
coords = Together[Most[vertex @@ #], Extension -> Sqrt[2]] & /@ hexagon;
denominators = Simplify[Denominator[#] /. v -> 0] & /@ coords;
limits = Simplify[# /. v -> 0] & /@ coords;
TableForm[Transpose[{Values[denominators], Values[limits]}],
 TableHeadings -> {Keys[hexagon], {\"denominators at v = 0\", \"(r0, r1) at v \
= 0\"}}]\
\>", "Input",
 CellLabel->"In[32]:=",ExpressionUUID->"2063ed74-2f91-43a7-97dc-9e1f7edbba40"],

Cell[BoxData[
 TagBox[
  TagBox[GridBox[{
     {
      StyleBox["\[Null]",
       ShowStringCharacters->False], 
      TagBox["\<\"denominators at v = 0\"\>",
       HoldForm], 
      TagBox["\<\"(r0, r1) at v = 0\"\>",
       HoldForm]},
     {
      TagBox["\<\"V1\"\>",
       HoldForm], 
      TagBox[GridBox[{
         {
          RowBox[{
           RowBox[{"-", "4"}], "+", 
           RowBox[{"3", " ", 
            SqrtBox["2"]}]}]},
         {"1"}
        },
        GridBoxAlignment->{"Columns" -> {{Left}}, "Rows" -> {{Baseline}}},
        GridBoxSpacings->{"Columns" -> {
            Offset[0.27999999999999997`], {
             Offset[0.5599999999999999]}, 
