            Offset[0.27999999999999997`]}, "Rows" -> {{
             Offset[0.2]}}}],
       Column]},
     {
      TagBox["\<\"V2\"\>",
       HoldForm], 
      TagBox[GridBox[{
         {
          RowBox[{
           RowBox[{"-", "10"}], "+", 
           RowBox[{"7", " ", 
            SqrtBox["2"]}]}]},
         {
          RowBox[{
           RowBox[{"-", "10"}], "+", 
           RowBox[{"7", " ", 
            SqrtBox["2"]}]}]}
        },
        GridBoxAlignment->{"Columns" -> {{Left}}, "Rows" -> {{Baseline}}},
