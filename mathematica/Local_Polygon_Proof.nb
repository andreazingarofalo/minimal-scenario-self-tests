   {OutputFormsDump`HeadedRows, OutputFormsDump`HeadedColumns}],
  Function[BoxForm`e$, 
   TableForm[
   BoxForm`e$, 
    TableHeadings -> {{"V1", "V2", "V3", "V4", "V3'", "V2'"}, {
      "lines not parallel", "other constraints strict"}}]]]], "Output",
 CellChangeTimes->{4.002794994214148*^9},
 CellLabel->
  "Out[23]//TableForm=",ExpressionUUID->"69c62f4a-c1c2-4c65-9398-\
0b8bb4e08ec6"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Octagon, \[Theta]bar < \[Theta] \[LessEqual] \[Pi]/4", "Subsection",ExpressionUUID->"a8b09832-953b-4695-b45f-d116278daa82"],

Cell["\<\
Above \[Theta]bar the vertex V2 splits into V5 and V6, and V2' into V5' and \
V6'.\
\>", "Text",ExpressionUUID->"d3bfc867-d0dd-4404-900b-93615361e355"],

Cell[CellGroupData[{

Cell["\<\
octagon = <|\"V1\" -> {detII[1, 1], detII[-1, 1]}, \"V5\" -> {detII[-1, 1], \
detI[-1, 1]},
   \"V6\" -> {detI[1, 1], detI[-1, 1]}, \"V3\" -> {detI[1, 1], detII[-1, \
-1]},
   \"V4\" -> {detII[1, -1], detII[-1, -1]}, \"V3'\" -> {detI[1, -1], detII[1, \
-1]},
   \"V6'\" -> {detI[1, -1], detI[-1, -1]}, \"V5'\" -> {detII[1, 1], detI[-1, \
-1]}|>;
octCheck = check[#, vbar, 1] & /@ octagon;
TableForm[Values[octCheck], TableHeadings -> {Keys[octagon], {\"lines not \
parallel\", \"other constraints strict\"}}]\
\>", "Input",
 CellLabel->"In[24]:=",ExpressionUUID->"c7a73675-4a03-46b0-abee-07da4d49f61f"],

Cell[BoxData[
 TagBox[
  TagBox[GridBox[{
     {
      StyleBox["\[Null]",
       ShowStringCharacters->False], 
      TagBox["\<\"lines not parallel\"\>",
       HoldForm], 
      TagBox["\<\"other constraints strict\"\>",
       HoldForm]},
     {
      TagBox["\<\"V1\"\>",
       HoldForm], "True", "True"},
     {
      TagBox["\<\"V5\"\>",
       HoldForm], "True", "True"},
     {
      TagBox["\<\"V6\"\>",
       HoldForm], "True", "True"},
